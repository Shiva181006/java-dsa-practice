import java.util.*;
public class FindElementInArray {
  public static void main(String []args){
    Scanner sc =new Scanner(System.in);
    int n=sc.nextInt();
    int arr[]= new int[n];
    for(int i=0;i<n;i++){
      arr[i]=sc.nextInt();
    }
    System.out.println("Enter Target");
    int target=sc.nextInt();

    for(int j=0;j<n;j++){
      if(arr[j]==target){
        System.out.println(j);
        return;
      }
    }
  }
}
